# Database (Neon PostgreSQL or Supabase)
DATABASE_URL="postgresql://username:password@host/neondb?sslmode=require"

# NextAuth Authentication (Generate a random 32-char secret)
NEXTAUTH_SECRET="your-random-32-character-secret-key"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Razorpay (Live or Test Mode Keys)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"

# Resend Email Automation
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Google OAuth (Optional: From Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brand & Contact
CONTACT_EMAIL="arisharajput100@gmail.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
